# API Backend - Producción
# Detección DINÁMICA: El frontend detectará automáticamente la IP del host
# Resultado: http://[IP-HOST]:8000/api

# NO hardcodear IP - permite que cada PC use su propia IP
# Override para producción local apuntando a Django
VITE_API_BASE_URL=http://127.0.0.1:9000/api/v1

# Ambiente
VITE_ENV=production
